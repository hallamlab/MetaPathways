        expand(config['ref_db_dir'] + '/functional/formatted/{func_db}-names.txt',
               func_db = functional_db_names_noMeta),
        expand(config['ref_db_dir'] + '/taxonomic/formatted/{tax_db}-names.txt',
               tax_db = taxonomic_db_names),
        config['ref_db_dir'] + '/functional_categories/EC_map.swissprot.tsv',
        config['ref_db_dir'] + '/ncbi_tree/ncbi_taxonomy_tree.txt'

rule create_dirs_local_files:
    input:
        config["ref_db_dir"] + '/starting_build'
    params:
        target_dir = config["ref_db_dir"]
    output:
        config["ref_db_dir"] + '/taxonomic/formatted/done'
    shell:
        """
        mkdir -p {params.target_dir}/functional/formatted
	mkdir -p {params.target_dir}/functional_categories
	mkdir -p {params.target_dir}/ncbi_tree
	mkdir -p {params.target_dir}/taxonomic/formatted
	touch {params.target_dir}/taxonomic/formatted/done
        """
        
rule fetch_silva_db:
    input:
        config["ref_db_dir"] + '/taxonomic/formatted/done'
    params:
        target_dir = config["ref_db_dir"],
        arb_release = arb_release
    output:
        lsu_silva_file = expand(config["ref_db_dir"] + '/taxonomic/SILVA_{arb_release}_LSURef_NR99_tax_silva_trunc', arb_release=arb_release),
        ssu_silva_file = expand(config["ref_db_dir"] + '/taxonomic/SILVA_{arb_release}_SSURef_NR99_tax_silva_trunc', arb_release=arb_release)
    shell:
        """
        cd {params.target_dir}/taxonomic
        wget -O SILVA_{arb_release}_LSURef_NR99_tax_silva_trunc.gz https://www.arb-silva.de/fileadmin/silva_databases/current/Exports/SILVA_{arb_release}_LSURef_NR99_tax_silva_trunc.fasta.gz
        wget -O SILVA_{arb_release}_SSURef_NR99_tax_silva_trunc.gz https://www.arb-silva.de/fileadmin/silva_databases/current/Exports/SILVA_{arb_release}_SSURef_NR99_tax_silva_trunc.fasta.gz
        gunzip {output.lsu_silva_file}.gz
        gunzip {output.ssu_silva_file}.gz
        """

rule make_silva_blast_db:
    input:
        lsu_silva_file = expand(config["ref_db_dir"] + '/taxonomic/SILVA_{arb_release}_LSURef_NR99_tax_silva_trunc', arb_release=arb_release),
        ssu_silva_file = expand(config["ref_db_dir"] + '/taxonomic/SILVA_{arb_release}_SSURef_NR99_tax_silva_trunc', arb_release=arb_release)
    params:
        target_dir = config["ref_db_dir"],
        arb_release = arb_release
    output:
        expand(config["ref_db_dir"] + '/taxonomic/formatted/SILVA_{arb_release}_LSURef_NR99_tax_silva_trunc.ndb', arb_release=arb_release),
        expand(config["ref_db_dir"] + '/taxonomic/formatted/SILVA_{arb_release}_SSURef_NR99_tax_silva_trunc.ndb', arb_release=arb_release)
    shell:
        """
        cd {params.target_dir}/taxonomic
        makeblastdb -in SILVA_{arb_release}_LSURef_NR99_tax_silva_trunc -dbtype nucl -parse_seqids -out formatted/SILVA_{arb_release}_LSURef_NR99_tax_silva_trunc
        makeblastdb -in SILVA_{arb_release}_SSURef_NR99_tax_silva_trunc -dbtype nucl -parse_seqids -out formatted/SILVA_{arb_release}_SSURef_NR99_tax_silva_trunc           """

rule fetch_uniref90_db:
    input:
        config["ref_db_dir"] + '/starting_build'
    params:
        target_dir = config['ref_db_dir']
    output:
        config["ref_db_dir"] + '/functional/uniref90'
    shell:
        """
        cd {params.target_dir}/functional
        wget -O uniref90.gz https://ftp.uniprot.org/pub/databases/uniprot/uniref/uniref90/uniref90.fasta.gz
        gunzip uniref90.gz
        """

rule make_uniref90_blast_db:
    input:
        config["ref_db_dir"] + '/functional/uniref90'
    params:
        target_dir = config['ref_db_dir']
    output:
        config["ref_db_dir"] + '/functional/formatted/uniref90.pdb'
    shell:
        """
        cd {params.target_dir}/functional
        makeblastdb -in {input} -dbtype prot -parse_seqids -out formatted/uniref90
        """

rule make_uniref90_fast_db:
    input:
        config["ref_db_dir"] + '/functional/uniref90'
    params:
        target_dir = config['ref_db_dir']
    output:
        config["ref_db_dir"] + '/functional/formatted/uniref90.prj'
    shell:
        """
        cd {params.target_dir}/functional
        fastdb -p formatted/uniref90 {input}
        """

rule fetch_swissprot_db:
    input:
        config["ref_db_dir"] + '/starting_build'
    params:
        target_dir = config['ref_db_dir']
    output:
