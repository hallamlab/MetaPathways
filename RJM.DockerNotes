### Build the Docker image for MP3
sudo docker build --network=host -t metapathways:v3.5 -f RJM.Dockerfile .

### Test it with some sample data
sudo docker run -v /home/ryan/PycharmProjects/metapathways_engcyc/:/tmp/mp3/ -t metapathways:v3.5 MetaPathways -i /tmp/mp3/tests/data/input/lagoon-sample2.fasta -o /tmp/mp3/tests/data/output/dockertest/ -p /tmp/mp3/template_param.txt -d /tmp/mp3/tests/data/ref_data/ -v

### Clear all containers
sudo docker rm $(sudo docker ps -a -q)

### Have you built the Ptools Docker?
### Run Ptools v24.5
sudo docker run -v /home/ryan/PycharmProjects/metapathways_engcyc/tests/data/output/dockertest/lagoon-sample2/ptools:/data ptools:24.5-v1 run-pathway-tools.sh -patho /data -no-taxonomic-pruning -no-web-cel-overview -tip

# Extact ePGDB from image?
sudo docker cp $(sudo docker ps -a -q):/opt/data/ptools-local/pgdbs/user/ /home/ryan/PycharmProjects/metapathways_engcyc/tests/data/output/dockertest/lagoon-sample2/results/pgdb/
ls /home/ryan/PycharmProjects/metapathways_engcyc/tests/data/output/dockertest/lagoon-sample2/results/pgdb/

### Clear all containers
sudo docker rm $(sudo docker ps -a -q)

### How to push to Quay.io
sudo docker login quay.io
# [input username and password]
# Create containers for MP3 and Ptools to push
sudo docker run -t metapathways:v3.5 ls
sudo docker run ptools:24.5-v1 ls
# Commit using container ID
sudo docker commit 13fc31eeac0b quay.io/mcglock/mp_v3.5
sudo docker commit c7bb1c07e921 quay.io/mcglock/pt_v24.5
# Push to Quay.io
sudo docker push quay.io/mcglock/mp_v3.5
sudo docker push quay.io/mcglock/pt_v24.5

### Clear all containers
sudo docker rm $(sudo docker ps -a -q)

